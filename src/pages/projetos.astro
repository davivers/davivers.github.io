---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
import { withBase } from '../utils';
---

<Base title="Projetos" wide>
  <h1 class="section-title page-title">Projetos</h1>
  <div class="grid">
    {projects.map((p) => {
      const Card = p.url ? 'a' : 'div';
      return (
        <Card class="card" {...(p.url ? { href: p.url, target: '_blank', rel: 'noopener' } : {})}>
          <div class="thumb" style={`--h:${p.hue}`}>
            {p.image ? <img src={withBase(p.image)} alt="" /> : <span class="glyph">{p.glyph}</span>}
          </div>
          <h3>{p.title}</h3>
          <p class="muted">{p.summary}</p>
          <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
        </Card>
      );
    })}
  </div>
</Base>

<style>
  .page-title { font-size: 1.5rem; margin-bottom: 24px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 24px; }
  .card { color: var(--fg); text-align: center; display: block; }
  .card:hover { text-decoration: none; }
  .thumb {
    aspect-ratio: 16 / 10; border-radius: 12px; overflow: hidden; display: grid; place-items: center;
    background:
      linear-gradient(45deg, hsl(var(--h) 45% 50% / 0.18) 25%, transparent 25%) 0 0 / 18px 18px,
      linear-gradient(135deg, hsl(var(--h) 55% 58%), hsl(calc(var(--h) + 40) 50% 38%));
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .card[href]:hover .thumb { transform: translateY(-3px); box-shadow: 0 12px 24px rgba(0,0,0,0.18); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .glyph { font-family: 'JetBrains Mono', monospace; font-size: 2.6rem; color: #fff; font-weight: 600; opacity: 0.92; }
  h3 { margin: 12px 0 4px; font-size: 1.15rem; }
  p { margin: 0 0 8px; font-size: 0.92rem; }
  .tags { display: flex; justify-content: center; flex-wrap: wrap; gap: 6px; }
</style>
