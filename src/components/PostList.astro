---
import type { CollectionEntry } from 'astro:content';
import { withBase, formatDate, readingTime } from '../utils';
interface Props { posts: CollectionEntry<'blog'>[] }
const { posts } = Astro.props;
---
<ul class="posts">
  {posts.map((p) => (
    <li>
      <a href={withBase(`/blog/${p.id}/`)} class="post">
        <div class="meta muted">
          <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
          <span>·</span>
          <span>{readingTime(p)}</span>
        </div>
        <h3>{p.data.title}</h3>
        <p class="muted">{p.data.description}</p>
        {p.data.tags.length > 0 && (
          <div class="tags">{p.data.tags.map((t) => <span class="tag">#{t}</span>)}</div>
        )}
      </a>
    </li>
  ))}
</ul>

<style>
  .posts { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .post {
    display: block; padding: 16px 18px; border-radius: 12px; color: var(--fg);
    background: var(--card); border: 1px solid var(--line);
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .post:hover { text-decoration: none; transform: translateY(-2px); border-color: var(--accent); }
  .meta { font-size: 0.8rem; display: flex; gap: 6px; }
  h3 { margin: 4px 0 4px; font-size: 1.1rem; }
  p { margin: 0 0 8px; font-size: 0.95rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
</style>
